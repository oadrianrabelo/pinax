{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    ["@semantic-release/commit-analyzer", { "preset": "conventionalcommits" }],
    ["@semantic-release/release-notes-generator", {
      "preset": "conventionalcommits",
      "presetConfig": {
        "types": [
          { "type": "feat", "section": "✦ Novidades" },
          { "type": "fix", "section": "Correções" },
          { "type": "perf", "section": "Mais rápido" },
          { "type": "style", "section": "Visual" },
          { "type": "docs", "hidden": true }, { "type": "refactor", "hidden": true },
          { "type": "chore", "hidden": true }, { "type": "ci", "hidden": true }, { "type": "test", "hidden": true }
        ]
      }
    }],
    ["@semantic-release/changelog", { "changelogFile": "CHANGELOG.md", "changelogTitle": "# Diário de bordo" }],
    ["@semantic-release/npm", { "npmPublish": false }],
    ["@semantic-release/git", { "assets": ["CHANGELOG.md", "package.json", "package-lock.json"], "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}" }],
    "@semantic-release/github"
  ]
}
